# Pupitre : variables d'environnement.
# Copier ce fichier en .env, dans ce même dossier, et renseigner les valeurs.
# .env n'est jamais commité. Aucune de ces valeurs ne doit sortir dans un journal.

# Adresse de Pupitre, sans barre finale (pour les liens envoyés par mail et la ligne de commande)
APP_URL=
# dev ou prod (en dev, le détail des erreurs s'affiche)
APP_ENV=

# Base de données MySQL ou MariaDB
BD_HOTE=
BD_PORT=
BD_NOM=
BD_UTILISATEUR=
BD_MOT_DE_PASSE=

# Reprise (sql/depart.php) : nom de l'artiste et compte pilote
ARTISTE_NOM=
PILOTE_EMAIL=
PILOTE_NOM=

# IA : API d'Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODELE=
# Modèle des recherches sur le web (complément de l'annuaire, veille). Vide : le même. Ces recherches lisent
# beaucoup de pages : un modèle plus léger en réduit le coût.
ANTHROPIC_MODELE_RECHERCHE=

# Mails : Mailjet. Sans clé, les messages sont écrits dans stockage/journaux/mails.log
MAILJET_CLE=
MAILJET_SECRET=
MAIL_EXPEDITEUR=
MAIL_EXPEDITEUR_NOM=

# Boîte aux lettres de l'expéditeur, lue par IMAP pour suivre les retours des mails envoyés (réponses, absences,
# non-remises). Boîte OVH : IMAP_HOTE=ssl0.ovh.net, IMAP_PORT=993, IMAP_UTILISATEUR=l'adresse complète.
IMAP_HOTE=
IMAP_PORT=993
IMAP_UTILISATEUR=
IMAP_MOT_DE_PASSE=
IMAP_DOSSIER=INBOX

# Réseaux sociaux : Metricool (jeton d'API et identifiant du compte : Metricool › Paramètres du compte › API).
# La marque à lire se choisit dans les réglages de Pupitre, avec la bascule vers des comptes de test.
METRICOOL_JETON=
METRICOOL_UTILISATEUR=

# Outils : chemins complets. Vides : cherchés sur le poste
PHP_CLI=
PYTHON3=
FFMPEG=
